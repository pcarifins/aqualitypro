rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Default match rule for app operational data
    match /users/{userId} {
      allow read, write: if true;
    }

    match /assemblers/{assemblerId} {
      allow read, write: if true;
    }

    match /productModels/{modelId} {
      allow read, write: if true;
    }

    match /checksheetTemplates/{templateId} {
      allow read, write: if true;
    }

    match /checksheets/{checksheetId} {
      allow read, write: if true;
    }

    match /priorityQueue/{queueId} {
      allow read, write: if true;
    }

    match /gltRecords/{recordId} {
      allow read, write: if true;
    }

    match /dynoRecords/{recordId} {
      allow read, write: if true;
    }

    match /hydraulicRecords/{recordId} {
      allow read, write: if true;
    }

    match /certificates/{certId} {
      allow read, write: if true;
    }

    match /pdfReports/{reportId} {
      allow read, write: if true;
    }

    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    match /systemConfig/{configId} {
      allow read, write: if true;
    }

    match /testingLines/{lineId} {
      allow read, write: if true;
    }

    match /_sync_test/{testId} {
      allow read, write: if true;
    }

    match /_connection_test/{testId} {
      allow read, write: if true;
    }
  }
}
